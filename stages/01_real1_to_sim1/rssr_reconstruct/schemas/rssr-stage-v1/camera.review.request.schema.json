{
  "type": "object",
  "properties": {
    "protocol": {
      "const": "rssr.stage.v1"
    },
    "request_id": {
      "type": "string",
      "maxLength": 64
    },
    "stage": {
      "const": "camera.review"
    },
    "context": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "maxLength": 500
        },
        "full_evidence_sha256": {
          "type": "string",
          "maxLength": 500
        },
        "candidate_sha256": {
          "type": "string",
          "maxLength": 500
        },
        "frame": {
          "type": "string",
          "maxLength": 500
        },
        "length_unit": {
          "type": "string",
          "maxLength": 500
        },
        "angle_unit": {
          "type": "string",
          "maxLength": 500
        },
        "camera_axes": {
          "type": "string",
          "maxLength": 500
        },
        "calibration": {
          "type": "string",
          "maxLength": 500
        },
        "sim2_success": {
          "type": "string",
          "maxLength": 500
        },
        "state_trace_presentation": {
          "type": "string",
          "maxLength": 500
        },
        "memory_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sim1_success_required": {
          "const": false
        }
      },
      "required": [
        "case_id",
        "full_evidence_sha256",
        "candidate_sha256",
        "frame",
        "length_unit",
        "angle_unit",
        "camera_axes",
        "calibration",
        "sim2_success",
        "state_trace_presentation",
        "memory_version",
        "sim1_success_required"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        },
        "available_stages": {
          "type": "array"
        },
        "source_frame_indices": {
          "type": "array"
        },
        "source_task_success_required": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "object"
        },
        "not_measured_calibration": {
          "type": "boolean"
        },
        "frame_mapping": {
          "type": "object"
        },
        "camera_phase": {
          "type": "string"
        }
      },
      "required": [
        "task",
        "available_stages",
        "source_frame_indices",
        "source_task_success_required",
        "diagnostics",
        "not_measured_calibration"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 30
          },
          "label": {
            "type": "string",
            "maxLength": 180
          },
          "sha256": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "label",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "protocol",
    "request_id",
    "stage",
    "context",
    "input",
    "assets"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}