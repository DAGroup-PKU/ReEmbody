                      "uniqueItems": true,
                      "maxItems": 40
                    },
                    "excluded": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,39}$"
                      },
                      "uniqueItems": true,
                      "maxItems": 40
                    },
                    "particles": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,39}$"
                      },
                      "uniqueItems": true,
                      "maxItems": 40
                    },
                    "target_region": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,39}$"
                        }
                      ]
                    },
                    "articulation": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,39}$"
                        }
                      ]
                    }
                  },
                  "required": [
                    "targets",
                    "containers",
                    "excluded",
                    "particles",
                    "target_region",
                    "articulation"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "schema",
                "task_id",
                "objects",
                "bindings"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "supported",
        "reason",
        "scene"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "request_id",
    "stage",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}